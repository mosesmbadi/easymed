# Rendered at container start by the nginx image's envsubst step into
# /etc/nginx/conf.d/default.conf. Only ${VARS} that are set in the container's
# environment are substituted, so nginx's own $host, $request_uri etc. pass
# through untouched.
#
#   NGINX_SERVER_NAME   space-separated host names, e.g. "hmis.example.com www.hmis.example.com"
#   NGINX_CERT_DOMAIN   the Let's Encrypt certificate directory under /etc/letsencrypt/live/

server {
    listen 80;
    server_name ${NGINX_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate /etc/letsencrypt/live/${NGINX_CERT_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${NGINX_CERT_DOMAIN}/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    location / {
        proxy_pass http://frontend:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }
}
